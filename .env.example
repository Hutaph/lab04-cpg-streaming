# Project Environment Configuration Example

# Target Repository
SOURCE_REPOSITORY_URL=https://github.com/huggingface/transformers-pr-agent.git
SOURCE_REPOSITORY_ID=transformers-pr-agent
SOURCE_REPOSITORY_PATH=workspace/source/transformers-pr-agent

# Apache Kafka
# Host processes such as CLI, pytest, and notebooks use localhost:9092.
# Docker containers such as Kafka Connect and Spark use kafka:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka Topics
TOPIC_NODES=cpg.nodes
TOPIC_EDGES=cpg.edges
TOPIC_METADATA=source.metadata
TOPIC_ERRORS=parser.errors
TOPIC_CONNECTOR_ERRORS=connector.errors

# Neo4j
# Host processes use bolt://localhost:7687.
# Kafka Connect uses bolt://cpg-neo4j:7687.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# MongoDB for Task 5–6
# Host processes and Jupyter notebooks use localhost:27018.
# Spark containers use cpg-mongodb-metadata:27017.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD

# Host-side MongoDB URI.
# Replace CHANGE_ME_MONGO_PASSWORD directly in the local .env file.
MONGODB_URI=mongodb://root:CHANGE_ME_MONGO_PASSWORD@localhost:27018/?authSource=admin

MONGODB_DATABASE=cpg_metadata
MONGODB_COLLECTION=file_statistics

# Isolated MongoDB Service for Task 5–6
MONGODB_HOST_PORT=27018
MONGODB_CONTAINER_HOST=cpg-mongodb-metadata
MONGODB_CONTAINER_PORT=27017
MONGODB_CONTAINER_NAME=cpg-mongodb-metadata

# Apache Spark Structured Streaming
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_PATH=workspace/checkpoints/spark
KAFKA_STARTING_OFFSETS=earliest

# Parser State Database
PARSER_STATE_DB=workspace/state/parser_state.sqlite3
