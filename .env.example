# Project Env Configurations Example

# Target Repository Configs
SOURCE_REPOSITORY_URL=https://github.com/huggingface/transformers-pr-agent.git
SOURCE_REPOSITORY_ID=transformers-pr-agent
SOURCE_REPOSITORY_PATH=workspace/source/transformers-pr-agent

# Apache Kafka Broker Settings
# Note: Host processes (e.g., Task 3 CLI, pytest, notebook) use localhost:9092
# Docker containers (e.g., Kafka Connect, Spark) use the internal service address kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Target Kafka Topics Configuration
TOPIC_NODES=cpg.nodes
TOPIC_EDGES=cpg.edges
TOPIC_METADATA=source.metadata
TOPIC_ERRORS=parser.errors
TOPIC_CONNECTOR_ERRORS=connector.errors

# Neo4j Graph Database Credentials
# Note: Host processes use bolt://localhost:7687
# Kafka Connect uses the internal container address bolt://cpg-neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# MongoDB Settings (Task 5 placeholders)
# Note: Host processes use localhost:27017
# Spark streaming use the internal address cpg-mongodb:27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
MONGODB_URI=mongodb://root:CHANGE_ME_MONGO_PASSWORD@localhost:27017/?authSource=admin
MONGODB_DATABASE=cpg_metadata
MONGODB_COLLECTION=file_statistics

# Apache Spark Structured Streaming (Task 5 placeholders)
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_PATH=workspace/checkpoints/spark
KAFKA_STARTING_OFFSETS=earliest

# Parser State DB Path (SQLite)
# Note: Exact canonical path matches workspace/state/parser_state.sqlite3
PARSER_STATE_DB=workspace/state/parser_state.sqlite3
